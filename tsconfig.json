{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "typeRoots": ["./tools/types/node_modules/@types"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bin/**/*.js", "lib/**/*.js", "supply-chain/**/*.js", "projects/bin/**/*.js", "ai-tooling/bin/**/*.js", "fleet/bin/**/*.js", "tools/*.js", "test/**/*.js"],
  "exclude": ["node_modules", "tools/types", "archive"]
}
