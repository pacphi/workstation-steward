#!/usr/bin/env bash
# Point ~/.config/mise/{config.toml,mise.lock} ([paths] mise_config_dir) at the instance's mise/ (idempotent). A real
# file already there is kept as <name>.pre-link. Usage: link      DRY_RUN=1 link
# shellcheck source=lib/lib.sh
source "$(dirname "$0")/../../lib/lib.sh"

m="${INSTANCE_ROOT}/mise"
for f in config.toml mise.lock; do
  t="${STEWARD_PATHS_MISE_CONFIG_DIR}/${f}"
  if [[ "${DRY_RUN}" == 1 ]]; then echo "   \$ ln -sfn ${m}/${f} ${t}"; continue; fi
  [[ -L "${t}" ]] || { [[ -e "${t}" ]] && mv "${t}" "${t}.pre-link"; }
  ln -sfn "${m}/${f}" "${t}"
done
ls -l "${STEWARD_PATHS_MISE_CONFIG_DIR}/config.toml" "${STEWARD_PATHS_MISE_CONFIG_DIR}/mise.lock"
