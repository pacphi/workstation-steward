#!/usr/bin/env bash
# (Re)install the npm -g hybrids from hybrids.toml into the active Node: each on its own, with its reviewed install
# scripts, a Ruflo policy backup when Ruflo's version changes, and a receipt (install_hybrids in lib/lib.sh); then reshim.
# Usage: install-hybrids      DRY_RUN=1 install-hybrids
# shellcheck source=lib/lib.sh
source "$(dirname "$0")/../../lib/lib.sh"

# It asks nothing at a terminal (it never has); under --unattended (steward upgrade, steward fix) [autonomy] must allow
# install-hybrids, or it stops here with exit 4 before anything is installed
if [[ "${STEWARD_UNATTENDED:-}" == "1" && "${DRY_RUN:-}" != "1" ]]; then
  node "${REPO_ROOT}/lib/autonomy.js" --answer install-hybrids "Install the hybrids from hybrids.toml into the active Node?" || exit 4
fi
install_hybrids
run mise reshim
