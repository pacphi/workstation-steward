#!/usr/bin/env bash
# (Re)install the npm -g hybrids from hybrids.toml into the active Node: each on its own, with its reviewed install
# scripts, a Ruflo policy backup when Ruflo's version changes, and a receipt (install_hybrids in lib/lib.sh); then reshim.
# Usage: install-hybrids      (plans, asks [y/N])      DRY_RUN=1 install-hybrids
# shellcheck source=lib/lib.sh
source "$(dirname "$0")/../../lib/lib.sh"

# The plan, then one question (class install-hybrids): under --unattended (steward upgrade, steward fix) [autonomy]
# answers it, or it stops with exit 4 before anything is installed. DRY_RUN=1 previews every step
n="$(hybrids_json | yq '. | length')"
(( n > 0 )) || { log "no hybrids in hybrids.toml: nothing to install"; exit 0; }
hybrids_plan
confirm "Install the hybrids above (${n}) into the active Node?" install-hybrids || { log "nothing changed"; exit 0; }
install_hybrids
run mise reshim
