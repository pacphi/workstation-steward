#!/usr/bin/env bash
# Evidence check before adding a `trust_policy_excludes` entry for an aube "trust downgrade":
# same publisher as the last attested release, and no install-time scripts. Read-only.
# Usage: trust-review <package@version>
# shellcheck source=lib/lib.sh
source "$(dirname "$0")/../../lib/lib.sh"

spec="${1:?usage: trust-review <package@version>}"
pkg="${spec%@*}"; ver="${spec##*@}"
# shellcheck disable=SC2016 # single quotes on purpose: the JavaScript is passed to node verbatim
curl -fsS "https://registry.npmjs.org/${pkg/\//%2f}" | node -e '
  let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
    const p = JSON.parse(s), ver = process.argv[1], v = p.versions[ver];
    if (!v) { console.log(`REJECT: ${ver} not published`); process.exit(2); }
    const attested = Object.keys(p.versions).filter(k => p.versions[k].dist && p.versions[k].dist.attestations);
    const last = attested.pop();
    const pub = (v._npmUser || {}).name, lastPub = last && (p.versions[last]._npmUser || {}).name;
    const scripts = ["preinstall", "install", "postinstall"].filter(k => (v.scripts || {})[k]);
    console.log(`  version     ${ver} published ${p.time[ver]} by ${pub}`);
    console.log(`  attested    ${!!(v.dist && v.dist.attestations)} (last attested: ${last || "never"} by ${lastPub || "-"})`);
    console.log(`  scripts     ${scripts.length ? scripts.join(", ") : "none"}${v.gypfile ? " + binding.gyp" : ""}`);
    const ok = pub && pub === lastPub && !scripts.length && !v.gypfile;
    console.log(ok ? `ACCEPT: add "${process.argv[2]}" to the trust_policy_excludes of the affected tool`
                   : "REJECT: publisher changed or install scripts present — investigate before excluding");
    process.exit(ok ? 0 : 1);
  });' "${ver}" "${spec}"
